# Environment Variables for Backend

# Gemini AI API Keys (rotation service uses 3 keys)
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3

# Pinecone Vector Database
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=voxveritas

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/crowdsourced-news?retryWrites=true&w=majority

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# Server Port
PORT=3000

# Admin Security Password (required for admin account creation)
ADMIN_SECURITY_PASSWORD=your_admin_security_password_here
